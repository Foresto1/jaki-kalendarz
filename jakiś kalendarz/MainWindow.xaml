<Window x:Class="jakiś_kalendarz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:jakiś_kalendarz"
        mc:Ignorable="d"
        Title="Pogoda" Height="620" Width="900" MinHeight="450" MinWidth="650">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock x:Name="TimeText" Text="HH:mm:ss" FontSize="42" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DateText" Text="DD.MM.YYYY" FontSize="18" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Button Content="Pogoda: Poznań" Click="PoznanButton_Click" Padding="16,8"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Text="Wybierz miasto, aby pobrać pogodę." FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="WeatherText" TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="DownloadedText" Grid.Row="2" Margin="0,10,0,0" Foreground="Gray"/>
        </Grid>
    </Grid>
</Window>
